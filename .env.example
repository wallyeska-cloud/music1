# Copy to .env and fill in your key. Set the same var in Netlify (Site settings > Environment variables).
SUNO_API_KEY=your_sunoapi_org_key_here

# Needed for "Sing it in my voice" (voice cloning + speech-to-speech). Server-side only.
# Requires an ElevenLabs plan that includes Instant Voice Cloning.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Optional overrides:
# SUNO_API_BASE=https://api.sunoapi.org
# SUNO_CALLBACK_URL=https://your-site.netlify.app/api/callback
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
